let hello_world: str = "Hello World!";
print(hello_world);

fun echo(x: int) -> int {
    x
}

fun add(x: int, y: int) -> int {
    x + y
}

fun subtract(x: int, y: int) -> int {
    x - y
}

fun negation(x: int) -> int {
    let negative_one: int = -1;
    x * negative_one
}

fun my_not(b: bool) -> bool {
    not b
}

let x: int = 1;
let y: int = 2;
let pi: f64 = 3.14;

negation(2);

let does_work: bool = true;

let does_not_work: bool = my_not(does_work);

echo(x);

let a: int = 5;
let b: int = 10;
let result: int = a + b * 2;
let logic: bool = a < b and not false;
let bit_shift: int = 1 << 3 | 2;

