// choices

choice OptionInt {
    | SomeInt(int)
    | None
}

fun divide(x: int, y: int) -> OptionInt {
    if y == 0{
        return OptionInt.None
    }
    OptionInt.Some(x / y)
}

fun print_divide(x: int, y: int) -> () {
    match divide(20, 5) {
        | Some(result) -> print(result)
        | None -> print("Can't divide by zero!")
    }
}

print_divide(5 / 0);

// references
let ref: &int = &x;

// anonymous function
let mult: (int, int) -> int = (x: int, y: int) -> x * y;

let nine: int = mult(3, 3);

for i: int in rang_five() {
    print(i);
}

let mut i: int = 0;
while true {
    if i >= 5 {
        break;
    }
    print(rang_five()[i]);
    i = i + 1;
}

let price_items: [(str, int); 3] = [("pogo_stick", 15), ("roller_skates", 30), ("keyboard", 50)];

for item: str, price: int in price_items {
    print(item);
    print(price);

    if item == "pogo_stick" {
        print("I am buying!");
    }
}