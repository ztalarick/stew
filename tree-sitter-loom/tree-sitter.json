{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "loom",
      "camelcase": "Loom",
      "title": "Loom",
      "scope": "source.loom",
      "file-types": [
        ".loom"
      ],
      "injection-regex": "^loom$",
      "class-name": "TreeSitterLoom"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Loom grammar for tree-sitter",
    "authors": [
      {
        "name": "Zach Talarick",
        "email": "ztalarick@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-loom",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}